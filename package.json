{
  "name": "expha-journee-inscriptions",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme d'inscription - Journee de formation et de detente (EXPHA)",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js",
    "dev:local": "node scripts/dev-with-mongo-memory.js",
    "smoke": "node scripts/smoke-test.js",
    "verify:static": "node scripts/verify-static.js",
    "verify:ui": "npm --prefix client run verify:ui",
    "check": "npm run smoke && npm run verify:static && npm run verify:ui"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4"
  }
}
