# Serveur
PORT=4000
NODE_ENV=development

# Base de donnees MongoDB (Atlas URI avec utilisateur/mot de passe encodes)
# Exemple Atlas :
# mongodb+srv://expha:monMotDePasse@cluster0.xxxxx.mongodb.net/expha?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/expha

# Secret de signature des sessions admin (changez-le en production)
JWT_SECRET=changez-ce-secret-en-production

# Mot de passe de l'espace administrateur
ADMIN_PASSWORD=expha2026

# Duree de validite de la session admin
JWT_EXPIRES_IN=12h

# Anti-spam : nombre max d inscriptions par IP et par fenetre
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
